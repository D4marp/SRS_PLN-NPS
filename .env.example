# ============================================================================
# DOCKER COMPOSE CONFIGURATION FOR SRS-PLN-NPS
# ============================================================================
# Copy to .env or .env.docker before running docker-compose
# cp .env.example .env.docker && docker-compose --env-file .env.docker up

# ============================================================================
# DATABASE CONFIGURATION (MySQL)
# ============================================================================
DB_HOST=db
DB_PORT=3306
DB_NAME=bookify
DB_USER=bookify_user
DB_PASSWORD=bookify_secure_password
DB_ROOT_PASSWORD=root

# ============================================================================
# BACKEND API CONFIGURATION (Go)
# ============================================================================
API_PORT=8080
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=168h
BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=*
SUPERADMIN_EMAIL=superadmin@bookify.local
SUPERADMIN_PASSWORD=superadmin123

# ============================================================================
# ADMIN WEB CONFIGURATION (Next.js)
# ============================================================================
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NODE_ENV=production

# ============================================================================
# DOCKER COMPOSE
# ============================================================================
COMPOSE_PROJECT_NAME=pln-nps
